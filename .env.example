# Ghost-User Environment Configuration

# Environment mode: development | test | production
NODE_ENV=development
ENVIRONMENT=development

# Database configuration (PostgreSQL-compatible, defaults to SQLite for local MVP)
DATABASE_URL=sqlite:///./data/ghost_user.db

# API Server configuration
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web Frontend configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Worker and Browser Execution
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_SECONDS=2
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
ACTION_TIMEOUT_MS=10000

# Artifacts storage (screenshots, traces)
ARTIFACT_STORAGE_DIR=./data/artifacts
TRACE_ON_FAILURE=true

# Security policies
# Set to true only in development/testing to allow testing localhost/127.0.0.1 targets
ALLOW_LOCAL_TARGETS=false
MAX_REDIRECTS=10
